# Environment Variables
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# URL do site oficial para Canonical e Sitemap (ex: https://www.studiobmkt.com.br)
VITE_SITE_URL=https://www.studiobmkt.com.br

# Supabase do site institucional. As chaves que começam com VITE_ são públicas
# por definição: nunca coloque a chave secreta do Supabase neste arquivo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Mantém o Firebase como fonte ativa até a migração dos dados e dos acessos
# administrativos estar concluída e validada.
VITE_DATA_BACKEND=firebase

# URL pública da aplicação Studio B Marketing (usada nos links de e-mail de autenticação e redefinição de senha)
APP_URL=https://ais-dev-pgw6p22matpwpq3qeqijvp-514008090755.us-east1.run.app

# Configurações de E-mail Transacional do Studio B Marketing (studiobmkt.com.br)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@studiobmkt.com.br
SMTP_PASS=
SMTP_FROM="Studio B Marketing <contato@studiobmkt.com.br>"
RESEND_API_KEY=

